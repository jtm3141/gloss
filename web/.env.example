# Local dev: point at the real database file. No Turso account needed.
# Relative to web/ — works on any machine with the repo checked out.
TURSO_DATABASE_URL=file:../data/gloss-filtered.db

# Production (set these as Vercel env vars, never commit them):
# TURSO_DATABASE_URL=libsql://gloss-<your-org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...
