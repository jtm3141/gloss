prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: gloss
Description: gloss dictionary engine (Open English WordNet data, C99 core)
URL: https://github.com/jtm3141/gloss
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lgloss
